# Local-only by default. Do not expose this service to the public internet.
RENDER_HOST=127.0.0.1
RENDER_PORT=4178

# Optional overrides
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# RENDER_CONCURRENCY=1
# MAX_RENDER_QUEUE=4
# MAX_UPLOAD_BYTES=8589934592
# MAX_PROJECT_BYTES=67108864
# RENDER_TEMP_DIR=/path/to/temporary/render/jobs
# ALLOWED_ORIGINS=https://your-github-pages-site.example

# Required before binding to a non-loopback address. This flag does not add
# authentication or TLS; put the service behind a secure gateway first.
# ALLOW_REMOTE_RENDER_SERVER=false
