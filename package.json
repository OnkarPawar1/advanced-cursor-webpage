{
  "name": "advanced-presenter-fx-av-mixer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:manual-hq": "node scripts/enable-manual-hq.mjs",
    "dev": "npm run prepare:manual-hq && vite --host 0.0.0.0",
    "dev:server": "npm run prepare:manual-hq && node --watch server/index.mjs",
    "dev:all": "npm run prepare:manual-hq && node scripts/dev.mjs",
    "build": "npm run prepare:manual-hq && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "npm run prepare:manual-hq && node server/index.mjs",
    "start:production": "npm run build && node server/index.mjs",
    "setup:mac": "bash scripts/setup-macos.sh",
    "check:ffmpeg": "node scripts/check-ffmpeg.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
